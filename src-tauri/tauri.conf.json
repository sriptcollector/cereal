{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbay Notes",
  "mainBinaryName": "toolbay-notes",
  "version": "0.1.1",
  "identifier": "ai.toolbay.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1447",
    "beforeBuildCommand": "npm run build && npm run bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "Toolbay",
    "homepage": "https://toolbay.ai",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Free, local AI meeting notes. No bot joins your call.",
    "longDescription": "Toolbay Notes records your side and the other side of any call (Zoom, Google Meet, Teams, Slack) without a bot, transcribes it on your computer, tells speakers apart, and turns your rough notes into clean meeting notes with a local AI. Free and open source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "bundled/": "bundled/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0Mzk5NTQ0OEEwQUMzMUUKUldRZXd3cUtSSlU1dEpWWjNJZ0hOMDFYaGNwbHpjT3F6TG5YNGtJZXdLUTYrc1RaYmJQd2luN08K",
      "endpoints": [
        "https://github.com/sriptcollector/toolbay-notes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}