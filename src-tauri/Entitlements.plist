<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime exceptions Cereal needs. Recording the computer's sound
       (ScreenCaptureKit) is a user permission in System Settings, not an entitlement. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The speech, speaker and notes engines are separate programs Cereal starts. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
